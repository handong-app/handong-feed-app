<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="app.handong.feed.mapper.archive.ArchiveNewsletterMapper">

    <select id="selectLatestRecord" resultType="app.handong.feed.dto.ArchiveDto$NewsletterDto">
        SELECT id, date, data, created_at
        FROM newsletter
        ORDER BY created_at DESC
            LIMIT 1
    </select>

</mapper>